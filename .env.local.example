# =============================================================
# EnigmAI – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================

# ------------------------------------------------------------------
# SUPABASE  (required)
# Get these from: Supabase Dashboard → Project Settings → API
# ------------------------------------------------------------------

# Your project URL  (safe to expose – used in browser too)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Anon / public key  (safe to expose – RLS policies protect your data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-role / secret key  (NEVER expose to the browser!)
# Used only in Server Components and Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------------

# The default store ID to use during development (from the seed data)
DEMO_STORE_ID=aaaaaaaa-0000-0000-0000-000000000001

# ------------------------------------------------------------------
# AI  (optional – needed if you wire up the chat completions endpoint)
# ------------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=sk-...

# OR Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
